# 本地开发配置模板
# 使用方法：复制本文件为同目录下的 application-local.yml，并填入真实值。
# application-local.yml 已加入 .gitignore，不会被提交到版本库。
# application.yml 中的 spring.profiles.active 默认为 local，启动时会自动加载本文件。

spring:
  datasource:
    username: root
    password: your_mysql_password

# JWT 签名密钥：建议使用随机字符串（例如 64 位十六进制）
jwt:
  secret: please-generate-a-random-secret
